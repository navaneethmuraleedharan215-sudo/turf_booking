Content-Type: application/json

{
    "user":"adminuser",
    "email":"adminuser@gmail.com",
    "password":"adminuser"
}

#list turf
###
GET http://127.0.0.1:8000/turf/
Accept: application/json

#adding
###
POST http://127.0.0.1:8000/turf/
Content-Type: application/json

{
    "team_name":"anandhu",
    "phone":"8704527866",
    "date":"2026-08-01",
    "duration":"1 hour",
    "fee":"1200"
}

###
GET http://127.0.0.1:8000/turf/1/
Accept: application/json

#updating
###
PUT http://127.0.0.1:8000/turf/1/
Content-Type: application/json


{
    "team_name":"ajay",
    "phone":"8704527866",
    "date":"2025-08-01",
    "duration":"2 hour",
    "fee":"1200"
}

